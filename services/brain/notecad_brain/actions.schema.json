{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notecad.local/schema/actions.schema.json",
  "title": "apply_capture_actions",
  "description": "Ionity NoteCad | Policy 986 AED | License AED 900. Actions extracted from one event of a voice capture.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capture_id", "event_index", "summary", "actions"],
  "properties": {
    "capture_id": { "type": "string" },
    "event_index": { "type": "integer", "minimum": 0 },
    "summary": { "type": "string", "maxLength": 200 },
    "actions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "nodeRef": { "type": "string", "minLength": 1, "description": "Existing node_id or a temp id like tmp:1 created earlier in this call" },
    "conf": { "type": "number", "minimum": 0, "maximum": 1 },
    "action": {
      "type": "object",
      "required": ["type", "confidence", "evidence"],
      "properties": { "type": { "enum": ["append_note", "create_node", "set_status", "create_alert", "create_task",
                                         "update_attributes", "link_nodes", "upsert_profile_fact", "ask_user"] } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "append_note" } } }, "then": {
          "properties": { "node_id": { "$ref": "#/$defs/nodeRef" }, "text": { "type": "string", "minLength": 1 },
                          "tags": { "type": "array", "items": { "type": "string" } },
                          "confidence": { "$ref": "#/$defs/conf" }, "evidence": { "type": "string" } },
          "required": ["node_id", "text"] } },
        { "if": { "properties": { "type": { "const": "create_node" } } }, "then": {
          "properties": { "temp_id": { "type": "string", "pattern": "^tmp:[0-9]+$" }, "parent_id": { "$ref": "#/$defs/nodeRef" },
                          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                          "kind": { "enum": ["category", "channel", "asset", "animal", "group", "field", "place", "person", "project", "topic"] },
                          "aliases": { "type": "array", "items": { "type": "string" } }, "attributes": { "type": "object" } },
          "required": ["temp_id", "parent_id", "title", "kind"] } },
        { "if": { "properties": { "type": { "const": "set_status" } } }, "then": {
          "properties": { "node_id": { "$ref": "#/$defs/nodeRef" },
                          "status": { "enum": ["ok", "info", "routine_due", "warning", "critical", "done"] },
                          "reason": { "type": "string" } },
          "required": ["node_id", "status", "reason"] } },
        { "if": { "properties": { "type": { "const": "create_alert" } } }, "then": {
          "properties": { "node_id": { "$ref": "#/$defs/nodeRef" }, "severity": { "enum": ["warning", "critical"] },
                          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                          "category": { "enum": ["health", "breakdown", "leak", "safety", "security", "loss", "other"] } },
          "required": ["node_id", "severity", "title", "category"] } },
        { "if": { "properties": { "type": { "const": "create_task" } } }, "then": {
          "properties": { "node_id": { "$ref": "#/$defs/nodeRef" }, "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                          "priority": { "enum": ["low", "normal", "high", "urgent"] },
                          "due_at": { "type": ["string", "null"] }, "assignee_hint": { "type": ["string", "null"] } },
          "required": ["node_id", "title", "priority"] } },
        { "if": { "properties": { "type": { "const": "update_attributes" } } }, "then": {
          "properties": { "node_id": { "$ref": "#/$defs/nodeRef" }, "set": { "type": "object" },
                          "increment": { "type": "object", "additionalProperties": { "type": "number" } } },
          "required": ["node_id"] } },
        { "if": { "properties": { "type": { "const": "link_nodes" } } }, "then": {
          "properties": { "src_id": { "$ref": "#/$defs/nodeRef" }, "dst_id": { "$ref": "#/$defs/nodeRef" },
                          "edge_type": { "enum": ["located_at", "affects", "related_to", "part_of", "assigned_to"] } },
          "required": ["src_id", "dst_id", "edge_type"] } },
        { "if": { "properties": { "type": { "const": "upsert_profile_fact" } } }, "then": {
          "properties": { "key": { "type": "string", "minLength": 1 }, "value": {} }, "required": ["key", "value"] } },
        { "if": { "properties": { "type": { "const": "ask_user" } } }, "then": {
          "properties": { "question": { "type": "string", "minLength": 1 },
                          "options": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["label", "node_id"],
                                       "properties": { "label": { "type": "string" }, "node_id": { "$ref": "#/$defs/nodeRef" } } } } },
          "required": ["question"] } }
      ]
    }
  }
}
